# Copy to .env for local use (do not commit .env)
# Hostinger MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — Expo web origins (comma-separated)
CORS_ORIGINS="http://localhost:8081,http://localhost:8082,http://localhost:8083"

# Server
PORT=4100
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:4100"
MARKETPLACE_PUBLIC_ORIGIN="https://store.qrshopmyanmar.com"

# Hostinger disk photo storage — keep OUTSIDE public_html on the server
# (see raw/hostinger-disk-uploads.md). Local default is ./uploads
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=10485760

# Optional: unlock detailed GET /health in production (header x-health-key or ?key=)
# HEALTH_DIAGNOSTICS_KEY=

# Admin Gmail — sends OTP so Admin can view a user account without that user's login.
# Use a Gmail App Password (Google Account → Security → App passwords).
# OTP_GMAIL_USER="admin@gmail.com"
# OTP_GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# OTP_TO_EMAIL="admin@gmail.com"
# Optional generic SMTP instead of Gmail:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Do not set SUPABASE_* — production DB is Hostinger MySQL; photos are disk uploads.
