{
  "name": "qr-shop-platform-api",
  "version": "0.1.0",
  "description": "Backend for QR Shop Marketplace, Merchant, and Admin.",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "npx prisma generate",
    "build": "npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed-login.js && node scripts/seed-three-merchants.js",
    "db:seed:townships": "node scripts/seed-townships.js",
    "db:seed:mall": "node scripts/seed-mall-meta.js",
    "db:seed:announcements": "node scripts/seed-announcements.js",
    "db:seed:merchants": "node scripts/seed-three-merchants.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "prisma": "^6.16.2",
    "serverless-http": "^3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "minimatch": "11.0.4"
  }
}
