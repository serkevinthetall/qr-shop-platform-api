# Preview / testing API (Hostinger api-preview)
# Copy to .env on the preview Node host. Use a SEPARATE MySQL database — never production.

# Hostinger MySQL — preview DB only (create e.g. uXXXX_qrshopapi_preview)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_PREVIEW"

# Auth — use a different secret from production
JWT_SECRET="change-me-preview-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — preview frontends only
CORS_ORIGINS="https://store-preview.qrshopmyanmar.com,https://merchant-preview.qrshopmyanmar.com,https://apanel-preview.qrshopmyanmar.com,http://localhost:8081,http://localhost:8082,http://localhost:8083"

PORT=4100
NODE_ENV=production
PUBLIC_BASE_URL="https://api-preview.qrshopmyanmar.com"
MARKETPLACE_PUBLIC_ORIGIN="https://store-preview.qrshopmyanmar.com"

# Disk uploads — separate folder from production
UPLOAD_DIR="./uploads-preview"
UPLOAD_MAX_BYTES=10485760

# Optional
# HEALTH_DIAGNOSTICS_KEY=
